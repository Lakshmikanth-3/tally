# Hedera testnet — Tally's own custodian ECDSA account (apps/console/lib/bonds.ts's
# getCustodian()). This is the real on-chain account of record for every bond this
# platform issues, arms coupons for, redeems, and places/fills secondary-market
# orders as — see packages/ats-client and apps/console/lib/secondary-market.ts.
# The account's EVM address is derived from the private key, not a separate var.
HEDERA_ECDSA_ACCOUNT_ID=0.0.xxxxx
HEDERA_ECDSA_PRIVATE_KEY=

# Optional: a second, independently-funded testnet account used as the real
# bondholder for armed coupon payments (apps/console/lib/coupon-schedule.ts), so
# the scheduled HBAR transfer is a genuine payer/payee transfer between two
# different accounts rather than the custodian paying itself. Falls back to the
# custodian account above if unset.
SECOND_ACCOUNT_ID=

# contracts/script/Deploy.s.sol — only needed to (re)deploy SettlementAnchor and
# SecondaryMarket. SETTLEMENT_RECORDER_ADDRESS is read via vm.envAddress; the
# operator key is passed as --private-key on the forge CLI, not read from .env.
#   forge script script/Deploy.s.sol --rpc-url hedera_testnet --broadcast --private-key $HEDERA_OPERATOR_EVM_KEY
SETTLEMENT_RECORDER_ADDRESS=
HEDERA_OPERATOR_EVM_KEY=

# Revenue data — served by Tally's own console API from businesses' real
# registered/submitted transactions (see apps/console/app/api/business/[issuerId]/revenue).
# The CRE workflow (cre/tally-cre) authenticates to it with this same bearer
# token, set there as CRE_REVENUE_API_TOKEN — see cre/tally-cre/.env.example
# and cre/tally-cre/secrets.yaml. The workflow's target console URL is
# config.staging.json/config.production.json's consoleBaseUrl field, not an
# env var.
REVENUE_API_TOKEN=

# Stripe Connect — lets a shop connect its real Stripe account as the
# authoritative revenue source (apps/console/lib/stripe.ts), instead of
# manually submitting transactions. STRIPE_SECRET_KEY is the platform's own
# secret key (test mode); STRIPE_CONNECT_CLIENT_ID comes from the Stripe
# Dashboard only after enabling Connect (Settings -> Connect -> Platform
# settings). STRIPE_CONNECT_REDIRECT_URI must exactly match what's
# registered there and match apps/console/app/api/business/stripe/callback.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=http://localhost:3000/api/business/stripe/callback

# The Graph — not currently read from .env by any script here: `pnpm
# subgraph:deploy` (subgraph/package.json) runs `graph deploy --studio
# tally-register`, which authenticates via a deploy key set once through
# `graph auth` (stored by the graph-cli itself), not an environment variable.
# Kept here for reference to the values used for the live deployment.
GRAPH_SUBGRAPH_SLUG=tally-register
